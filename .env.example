# Defaults run fully local: Iceberg JDBC catalog in an embedded H2 file (./lake/catalog.mv.db), warehouse in ./lake/warehouse.
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=fleet.telemetry
KAFKA_DLQ_TOPIC=fleet.telemetry.dlq
ICEBERG_CATALOG_URI=
ICEBERG_WAREHOUSE=
CHECKPOINT_DIR=
# Set these to put the warehouse on S3/MinIO (docker-compose.yml sets them for you):
# ICEBERG_WAREHOUSE=s3://lake/warehouse
# S3_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# In AWS: ICEBERG_CATALOG_URI=glue and ICEBERG_WAREHOUSE=<terraform output warehouse>
# Java 11+ (Iceberg 1.10). Unset = use .tools/jdk-17* if present, else `java` on PATH.
JAVA_HOME=
